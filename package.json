{
  "name": "pi-packages",
  "version": "0.1.0",
  "private": true,
  "description": "Personal extensions for Pi",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "license": "Apache-2.0",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "extensions",
    "skills"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/codex-settings/index.ts",
      "./extensions/bar-cursor.ts",
      "./extensions/footer-status/index.ts",
      "./extensions/gkd-workflow/index.ts"
    ],
    "skills": [
      "./skills/gkd-workloop"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^22.19.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "typebox": "1.3.27",
    "typescript": "~5.9.3"
  }
}
