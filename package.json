{
  "name": "pi-packages",
  "version": "0.1.0",
  "private": true,
  "description": "Personal extensions for Pi",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "license": "Apache-2.0",
  "keywords": ["pi-package"],
  "files": ["extensions"],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "pi": {
    "extensions": ["./extensions/codex-setting/index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3"
  }
}
